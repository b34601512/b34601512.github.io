# 压缩包文件
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.gz
*.bz2
*.xz

# 可执行文件
*.exe
*.msi
*.dmg
*.pkg
*.deb
*.rpm
*.app

# 打包产物目录
dist/
build/
out/
release/
packages/

# 临时文件和缓存
*.tmp
*.temp
*.cache
.DS_Store
Thumbs.db
__pycache__/

# 工具与本地工作目录（不要提交）
.claude/
.pi/
.imgtest/
.shots/

# headless Chrome 探针的临时文件（探针脚本与抓取结果，跑完就删）
p.html
p.js
.p.out
.W-*.out
.WW-*.out
.L-*
.L.*

# IDE 配置文件（可选，根据团队需要）
.vscode/
.idea/
*.swp
*.swo
*~
.perf*
# 探针输出：核对线上时会写在根目录，绝不能进仓库（会被 Pages 公开）
.live*.out
.reply*.out
.p.out
.live-site/
